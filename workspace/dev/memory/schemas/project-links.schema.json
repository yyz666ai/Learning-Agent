{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-links.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "path", "access", "learning_goal", "languages", "entry_points", "last_analyzed_at"],
        "properties": {
          "project_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "access": {"enum": ["read_only", "controlled_write"]},
          "learning_goal": {"type": "string", "minLength": 1},
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["python", "go"]}
          },
          "entry_points": {"type": "array", "items": {"type": "string"}},
          "last_analyzed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
